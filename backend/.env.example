# Copy to .env and adjust. Local defaults work without this file.
PROOFLOOP_ENV=development
PROOFLOOP_SECRET=change-me-to-at-least-24-random-characters
PROOFLOOP_DB=
PROOFLOOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
PROOFLOOP_RESEARCH=wikipedia
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Search grounding may require a different model than plain generation.
GEMINI_SEARCH_MODEL=

# AI engines. Live calls stay off until explicitly enabled, even with keys present.
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_SEARCH_ENABLED=false
PROOFLOOP_AI_LIVE_CALLS_ENABLED=false
PROOFLOOP_CLAIM_ENGINE=
PROOFLOOP_RESEARCH_ENGINE=
PROOFLOOP_ANALYSIS_ENGINE=
PROOFLOOP_REVIEW_ENGINE=
PROOFLOOP_SECOND_REVIEW_ENGINE=
PROOFLOOP_AI_TIMEOUT_SECONDS=20
PROOFLOOP_SEARCH_TIMEOUT_SECONDS=25
PROOFLOOP_AI_MAX_RETRIES=2
PROOFLOOP_AI_MAX_INPUT_CHARS=12000
PROOFLOOP_AI_MAX_OUTPUT_TOKENS=1200

# Automatic failover between OpenAI and Gemini (live calls must also be enabled).
AI_AUTO_FALLBACK_ENABLED=true
AI_PROVIDER_ORDER=openai,gemini
AI_FALLBACK_MAX_ATTEMPTS=2
AI_PROVIDER_COOLDOWN_SECONDS=300

# Momen Runtime API (server-only; never expose these through Vite).
MOMEN_GRAPHQL_URL=https://villa.momen.app/zero/vXL04vkvze2/api/graphql-v2
MOMEN_SUBSCRIPTION_URL=wss://villa.momen.app/zero/vXL04vkvze2/api/graphql-subscription
MOMEN_ADMIN_TOKEN=
MOMEN_TIMEOUT_SECONDS=15
